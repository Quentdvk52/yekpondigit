# ==============================================================================
# YEKPON DIGIT — Variables d'environnement (Modèle / .env.example)
# RÈGLE ABSOLUE : Ne JAMAIS commiter de vraies valeurs ou secrets dans ce fichier.
# ==============================================================================

# Application & Domaine
NEXT_PUBLIC_APP_NAME="YEKPON DIGIT"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEMO_BASE_URL="http://localhost:3001" # Domaine séparé et isolé pour les démos

# Base de Données PostgreSQL (Neon / Supabase)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
# Optionnel : Clé API Neon si utilisation du SDK serverless
NEON_API_KEY=""

# Stockage d'Objets S3 (Neon S3 / AWS S3 compatible)
AWS_ENDPOINT_URL_S3="https://storage-endpoint.example.com"
AWS_ACCESS_KEY_ID="your_access_key_id"
AWS_SECRET_ACCESS_KEY="your_secret_access_key"
AWS_REGION="us-east-2"
S3_BUCKET_PRIVATE="product-files"
S3_BUCKET_PUBLIC="public-assets"

# Authentification & Sessions
AUTH_SECRET="change-me-to-a-secure-random-32-chars-key"
ADMIN_2FA_ISSUER="YEKPON DIGIT"

# Rate Limiting & Cache (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Emails Transactionnels (Resend)
RESEND_API_KEY=""
EMAIL_FROM="YEKPON DIGIT <contact@yekpondigit.com>"

# Monitoring & Télémétrie
SENTRY_DSN=""

# Passerelles de Paiement
PAYMENT_PROVIDERS_ENABLED="fedapay,kkiapay,stripe,sandbox"

# FedaPay (Bénin / UEMOA - Mobile Money & Cartes)
FEDAPAY_SECRET_KEY=""
FEDAPAY_WEBHOOK_SECRET=""
FEDAPAY_ENV="sandbox"

# KKiaPay (Bénin - MTN MoMo, Moov, Celtiis, Cartes)
KKIAPAY_PUBLIC_KEY=""
KKIAPAY_PRIVATE_KEY=""
KKIAPAY_SECRET=""

# Moneroo (Afrique)
MONEROO_SECRET_KEY=""
MONEROO_WEBHOOK_SECRET=""

# Stripe (Paiements Internationaux par Carte)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Chiffrement & Signatures Cryptographiques
LICENSE_SIGNING_SECRET="change-me-to-a-very-long-hmac-secret-for-licenses"
DOWNLOAD_TOKEN_SECRET="change-me-to-a-very-long-secret-for-downloads"
DEMO_CREDENTIALS_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" # Clé hex 32 octets pour AES-256-GCM
CRON_SECRET="change-me-to-a-random-cron-secret"
